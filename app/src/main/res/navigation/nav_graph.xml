        android:name="com.brightnest.app.ui.WuduFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_content_list" />

    <fragment
        android:id="@+id/namesFragment"
        android:name="com.brightnest.app.ui.NamesFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_names" />

    <fragment
        android:id="@+id/prayerTimesFragment"
        android:name="com.brightnest.app.ui.PrayerTimesFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_prayer_times" />

    <fragment
        android:id="@+id/plannerFragment"
        android:name="com.brightnest.app.ui.PlannerFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_adult_tool" />

    <fragment
        android:id="@+id/notesFragment"
        android:name="com.brightnest.app.ui.NotesFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_adult_tool" />

    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.brightnest.app.ui.ExpensesFragment"
