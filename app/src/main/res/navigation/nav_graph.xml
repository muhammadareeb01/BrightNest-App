        android:id="@+id/subscriptionFragment"
        android:name="com.brightnest.app.ui.SubscriptionFragment"
        android:label="@string/f_subscription"
        tools:layout="@layout/fragment_subscription" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.brightnest.app.ui.SettingsFragment"
        android:label="@string/f_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/genericFragment"
        android:name="com.brightnest.app.ui.GenericFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_generic">
        <argument
            android:name="title"
            app:argType="string"
            android:defaultValue="BrightNest" />
    </fragment>

    <fragment
        android:id="@+id/cardGridFragment"
        android:name="com.brightnest.app.ui.CardGridFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_card_grid">
        <argument
            android:name="title"
            app:argType="string"
            android:defaultValue="ABC" />
    </fragment>

    <fragment
        android:id="@+id/vowelsFragment"
        android:name="com.brightnest.app.ui.VowelsFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_content_list" />

    <fragment
        android:id="@+id/vowelDetailFragment"
        android:name="com.brightnest.app.ui.VowelDetailFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_vowel_detail">
        <argument
            android:name="letter"
            app:argType="string"
            android:defaultValue="A" />
    </fragment>

    <fragment
        android:id="@+id/tensesFragment"
        android:name="com.brightnest.app.ui.TensesFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_content_list" />

    <fragment
        android:id="@+id/tenseDetailFragment"
        android:name="com.brightnest.app.ui.TenseDetailFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_tense_detail">
        <argument
            android:name="tenseName"
            app:argType="string"
            android:defaultValue="Present Simple" />
        <argument
            android:name="groupName"
            app:argType="string"
            android:defaultValue="Present" />
    </fragment>

    <fragment
        android:id="@+id/basicsFragment"
        android:name="com.brightnest.app.ui.BasicsFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_content_list" />

    <fragment
        android:id="@+id/basicDetailFragment"
        android:name="com.brightnest.app.ui.BasicDetailFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_basic_detail">
        <argument
            android:name="en"
            app:argType="string" />
        <argument
            android:name="ur"
            app:argType="string" />
        <argument
            android:name="color"
            app:argType="string" />
        <argument
            android:name="title"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/poemsFragment"
        android:name="com.brightnest.app.ui.PoemsFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_poems" />

