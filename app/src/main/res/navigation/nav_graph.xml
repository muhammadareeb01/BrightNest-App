        tools:layout="@layout/fragment_adult_tool" />

    <fragment
        android:id="@+id/habitsFragment"
        android:name="com.brightnest.app.ui.HabitsFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_adult_tool" />

    <fragment
        android:id="@+id/goalsFragment"
        android:name="com.brightnest.app.ui.GoalsFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_adult_tool" />

    <fragment
        android:id="@+id/tasbeehFragment"
        android:name="com.brightnest.app.ui.TasbeehFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_adult_tool" />

    <fragment
        android:id="@+id/waterFragment"
        android:name="com.brightnest.app.ui.WaterFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_adult_tool" />

    <fragment
        android:id="@+id/englishFragment"
        android:name="com.brightnest.app.ui.EnglishFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_adult_tool" />

    <fragment
        android:id="@+id/freelanceFragment"
        android:name="com.brightnest.app.ui.FreelanceFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_adult_tool" />

    <fragment
        android:id="@+id/businessFragment"
        android:name="com.brightnest.app.ui.BusinessFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_adult_tool" />

    <fragment
        android:id="@+id/parentControlFragment"
        android:name="com.brightnest.app.ui.ParentControlFragment"
        android:label="BrightNest"
        tools:layout="@layout/fragment_adult_tool" />
</navigation>
