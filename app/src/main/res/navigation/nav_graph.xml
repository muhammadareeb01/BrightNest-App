<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Bottom tabs -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.brightnest.app.ui.HomeFragment"
        android:label="@string/tab_home" />

    <fragment
        android:id="@+id/learnFragment"
        android:name="com.brightnest.app.ui.LearnFragment"
        android:label="@string/tab_learn"
        tools:layout="@layout/fragment_grid" />

    <fragment
        android:id="@+id/aiFragment"
        android:name="com.brightnest.app.ui.AiFragment"
        android:label="@string/tab_ai"
        tools:layout="@layout/fragment_ai" />

    <fragment
        android:id="@+id/alarmFragment"
        android:name="com.brightnest.app.ui.AlarmFragment"
        android:label="Alarm"
        tools:layout="@layout/fragment_alarm" />

    <fragment
        android:id="@+id/rewardsFragment"
        android:name="com.brightnest.app.ui.RewardsFragment"
        android:label="@string/tab_rewards"
        tools:layout="@layout/fragment_rewards" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.brightnest.app.ui.ProfileFragment"
        android:label="@string/tab_profile"
        tools:layout="@layout/fragment_profile" />

    <!-- Feature destinations -->
    <fragment
        android:id="@+id/quranFragment"
        android:name="com.brightnest.app.ui.QuranFragment"
        android:label="@string/f_quran"
        tools:layout="@layout/fragment_list" />

    <fragment
        android:id="@+id/kalmasFragment"
        android:name="com.brightnest.app.ui.KalmasFragment"
        android:label="@string/f_kalmas"
        tools:layout="@layout/fragment_list" />

    <fragment
        android:id="@+id/duasFragment"
        android:name="com.brightnest.app.ui.DuasFragment"
        android:label="@string/f_duas"
        tools:layout="@layout/fragment_list" />

    <fragment
        android:id="@+id/quizFragment"
        android:name="com.brightnest.app.ui.QuizFragment"
        android:label="@string/f_quiz"
        tools:layout="@layout/fragment_quiz" />

    <fragment
        android:id="@+id/tablesFragment"
        android:name="com.brightnest.app.ui.TablesFragment"
        android:label="@string/f_tables"
        tools:layout="@layout/fragment_tables" />

    <fragment
        android:id="@+id/drawingFragment"
        android:name="com.brightnest.app.ui.DrawingFragment"
        android:label="@string/f_drawing"
        tools:layout="@layout/fragment_drawing" />

    <fragment
        android:id="@+id/gamesFragment"
        android:name="com.brightnest.app.ui.GamesFragment"
        android:label="Mini Games"
        tools:layout="@layout/fragment_games" />

    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.brightnest.app.ui.LeaderboardFragment"
        android:label="Leaderboard"
        tools:layout="@layout/fragment_leaderboard" />

    <fragment
        android:id="@+id/storiesFragment"
        android:name="com.brightnest.app.ui.StoriesFragment"
        android:label="Stories"
        tools:layout="@layout/fragment_stories" />

    <fragment
        android:id="@+id/dodgingTablesFragment"
        android:name="com.brightnest.app.ui.DodgingTablesFragment"
        android:label="Dodging Tables"
        tools:layout="@layout/fragment_dodging_tables" />

    <fragment
        android:id="@+id/memoryFragment"
        android:name="com.brightnest.app.ui.MemoryFragment"
        android:label="Memory Match"
        tools:layout="@layout/fragment_memory" />

    <fragment
        android:id="@+id/puzzleFragment"
        android:name="com.brightnest.app.ui.PuzzleFragment"
        android:label="Slide Puzzle"
