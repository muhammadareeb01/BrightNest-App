<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:text="← Back"
            android:textColor="@color/foreground"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Vowel A"
            android:textColor="@color/coral"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="60dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Top Vowel Square Box + Mic Row -->
            <LinearLayout
                android:id="@+id/topSectionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="28dp">

                <!-- Square Box containing the Vowel Alphabet -->
                <FrameLayout
                    android:id="@+id/letterCardBox"
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/letterText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="A"
                        android:textSize="84sp"
                        android:textStyle="bold"
                        android:textColor="@color/coral" />
                </FrameLayout>

                <!-- Mic / Speaker button next to the square box (exact circle like bottom cards) -->
                <LinearLayout
                    android:id="@+id/btnListenLetter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginStart="24dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/micIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔊"
                        android:textSize="20sp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="20dp"
                android:background="@color/border" />

            <!-- Section Title before word cards -->
            <TextView
                android:id="@+id/wordsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Words with A"
                android:textColor="@color/foreground"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <!-- Container for Word Cards -->
            <LinearLayout
                android:id="@+id/wordsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
