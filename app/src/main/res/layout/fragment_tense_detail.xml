<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:text="← Back"
            android:textColor="@color/foreground"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Present Simple"
                android:textColor="@color/green_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headerUrdu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فعل حال سادہ"
                android:textColor="@color/muted_foreground"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="60dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Top Formula Card -->
            <LinearLayout
                android:id="@+id/formulaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/badgeCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Present Tense • زمانہ حال"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/green_primary"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/textTenseUrdu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="فعل حال"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/green_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textTenseName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Present Simple Tense"
                    android:textColor="@color/foreground"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Structure Formula Box -->
                <LinearLayout
                    android:id="@+id/formulaBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FORMULA / بناوٹ:"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/muted_foreground"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textFormula"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Subject + base verb (+s/es) + Object"
                        android:textColor="@color/foreground"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Example Sentences Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Example Sentences"
                    android:textColor="@color/foreground"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مثالیں"
                    android:textColor="@color/muted_foreground"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap any sentence or speaker icon to listen 🔊"
                android:textColor="@color/muted_foreground"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <!-- Sentences List Container -->
            <LinearLayout
                android:id="@+id/sentencesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
