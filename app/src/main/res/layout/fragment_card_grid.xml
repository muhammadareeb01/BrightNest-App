<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Grid view -->
    <LinearLayout
        android:id="@+id/gridRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/foreground"
                android:textSize="24sp"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/coral"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:text="Title" />

                <TextView
                    android:id="@+id/subTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted_foreground"
                    android:textSize="13sp"
                    android:text="اردو" />
            </LinearLayout>

            <View
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- Fruits/Veg tabs (shown only for Fruits screen) -->
        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="16dp"
            android:padding="4dp"
            android:background="@drawable/pill_track"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tabFruit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tabFruitLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fruits"
                    android:textStyle="bold"
                    android:textColor="@color/on_primary" />

                <TextView
                    android:id="@+id/tabFruitUrdu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="پھل"
                    android:textSize="11sp"
                    android:textColor="@color/on_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabVeg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tabVegLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vegetables"
                    android:textStyle="bold"
                    android:textColor="@color/foreground" />

                <TextView
                    android:id="@+id/tabVegUrdu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="سبزیاں"
                    android:textSize="11sp"
                    android:textColor="@color/muted_foreground" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- Detail view (Dedicated Full Screen) -->
    <LinearLayout
        android:id="@+id/detailRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Top Header Bar for Detail Screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/detailClose"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="← Back"
                android:textColor="@color/foreground"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/detailHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Learn Detail"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="60dp"
                android:layout_height="44dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="32dp">

                <!-- Big Illustration / Emoji Card -->
                <LinearLayout
                    android:id="@+id/detailCardBox"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:minHeight="240dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/card_rounded">

                    <TextView
                        android:id="@+id/detailLetter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="64sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:text="A" />

                    <TextView
                        android:id="@+id/detailEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="96sp"
                        android:gravity="center"
                        android:layout_marginTop="6dp"
                        android:text="🦁" />

                    <View
                        android:id="@+id/detailColorCircle"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:visibility="gone" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/detailDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:columnCount="10"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detailName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textColor="@color/foreground"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:text="Name" />

                <TextView
                    android:id="@+id/detailUrdu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:visibility="gone"
                    android:text="اردو" />

                <TextView
                    android:id="@+id/detailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/muted_foreground"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone"
                    android:text="" />

                <TextView
                    android:id="@+id/detailListen"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="32dp"
                    android:paddingHorizontal="28dp"
                    android:gravity="center"
                    android:text="🔊 Listen Pronunciation"
                    android:textColor="@color/on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
