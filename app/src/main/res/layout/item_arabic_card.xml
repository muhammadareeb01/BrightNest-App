<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="7dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border"
    app:cardBackgroundColor="@color/card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title Row with Theme Accent Indicator and Speaker Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="4dp"
                android:layout_height="20dp"
                android:background="@drawable/rounded_rect_primary"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/itemTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Dua Before Eating" />

            <ImageButton
                android:id="@+id/btnSpeak"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_icon_bg"
                android:contentDescription="Listen Supplication"
                android:padding="8dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="@color/primary" />

        </LinearLayout>

        <!-- Elegant Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:alpha="0.6" />

        <!-- Arabic Text Container with subtle rounded background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_arabic_box"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/itemArabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/foreground"
                android:textSize="22sp"
                android:lineSpacingExtra="8dp"
                android:textDirection="rtl"
                tools:text="بِسْمِ اللَّهِ وَعَلَىٰ بَرَكَةِ اللَّهِ" />
        </LinearLayout>

        <!-- Transliteration -->
        <TextView
            android:id="@+id/itemTranslit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/sage"
            android:textSize="13.5sp"
            android:textStyle="italic"
            android:lineSpacingExtra="2dp"
            tools:text="Bismillahi wa 'ala barakatillah" />

        <!-- Translation -->
        <TextView
            android:id="@+id/itemTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/muted_foreground"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            tools:text="In the name of Allah and with the blessings of Allah." />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
