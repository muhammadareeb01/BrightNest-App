<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Title row with speaker button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/itemTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Title"
                android:textColor="@color/green_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSpeak"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_icon_bg"
                android:contentDescription="Speak Kalma"
                android:padding="6dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="@color/green_primary" />

        </LinearLayout>

        <TextView
            android:id="@+id/itemArabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:text="العربية"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:lineSpacingExtra="8dp"
            android:textDirection="rtl" />

        <TextView
            android:id="@+id/itemTranslit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Transliteration"
            android:textColor="@color/accent_purple"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/itemTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Translation"
            android:textColor="@color/muted_foreground"
            android:textSize="14sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
